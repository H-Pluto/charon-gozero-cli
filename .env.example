# 环境变量示例。复制为 .env 后按需修改：  cp .env.example .env
#
# etc/*.yaml 里用 $VAR 的形式引用这些值（由 conf.UseEnv 展开）。
# .env 已在 .gitignore 里，不会被提交——密码只放这里。

# ---- 数据库 ----
# charon-api 启动时会连这个库；连不上则启动失败（不回退到内存实现）。
DB_DATA_SOURCE=postgres://postgres:postgres@127.0.0.1:5432/charon?sslmode=disable

# ---- 本地 Postgres 容器（docker-compose.yml 用）----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=charon
POSTGRES_PORT=5432

# ---- 鉴权 ----
# none / require / sdk
#   require 只校验 Bearer 非空，不验签；此模式禁止公网 Ingress。
# 这个值覆盖 etc/charon-api.yaml 里的 Auth.Mode 吗？——不覆盖。
# 鉴权模式目前直接写在 etc/charon-api.yaml 里，这里仅作说明。
# 如需按环境切换，把 yaml 里的 Mode 改成 $AUTH_MODE 再取消下一行注释。
# AUTH_MODE=none

# ---- 探针 ----
# 置 true 后 /health 与 /readyz 需要带 X-Health-Token 头。
# HEALTH_PROBE_REQUIRE_TOKEN=false
